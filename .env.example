# Copy to .env (never commit). All optional. The integration keys below can also be entered in the app (Settings), which takes priority over this file.
LIFE_PORT=5055
LIFE_HOST=127.0.0.1
# LIFE_HTTPS=1            # set when served over HTTPS (tailscale serve) so cookies are Secure
# LIFE_FERNET_KEY=        # else auto-generated into data/fernet.key (back this up!)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # optional: voice transcription via OpenAI (else a local model is used)
OMDB_API_KEY=         # optional: free key from omdbapi.com adds real year, cast, genre and IMDb rating to shared films and series
GMAIL_USER=
GMAIL_APP_PASSWORD=
GARMIN_EMAIL=
GARMIN_PASSWORD=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
